# =============================================================================
# 数据库
# =============================================================================
# PostgreSQL 连接字符串（开发环境对应 docker-compose.yml 的默认值）
DATABASE_URL="postgresql://email:email@localhost:5432/email_marketing?schema=public"
# Postgres 容器变量（仅 docker compose 使用，Web/Worker 不读）
POSTGRES_USER=email
POSTGRES_PASSWORD=email
POSTGRES_DB=email_marketing

# =============================================================================
# 认证与会话
# =============================================================================
# 管理员登录 token（生产请使用 32 字节以上随机串；与 EVENT_API_TOKEN 必须不同）
ADMIN_TOKEN=
# Cookie HMAC 签名密钥（32 字节以上随机字符串；可用 `openssl rand -base64 48` 生成）
SESSION_SECRET=

# =============================================================================
# Resend
# =============================================================================
# Resend API key（`re_` 开头）
RESEND_API_KEY=
# Resend webhook 签名密钥（`whsec_` 开头），由 svix 校验
RESEND_WEBHOOK_SECRET=

# =============================================================================
# 邮件与应用
# =============================================================================
# Next.js 启动端口（默认 3000）
PORT=8000
# 默认发件人邮箱
EMAIL_FROM="Marketing <news@example.com>"
# 应用基础 URL；用于生成退订链接、追踪像素与 webhook 回调
APP_URL=http://localhost:8000
# 是否启用双重确认订阅（true / false；默认 false）
DOUBLE_OPT_IN_ENABLED=false
# 媒体文件上传目录（默认 ./uploads）
UPLOAD_DIR=./uploads
# 测试邮件白名单（逗号分隔），仅这些地址允许通过测试发送 API
ADMIN_TEST_EMAILS=

# =============================================================================
# 频次控制（默认值，作用于未自定义 FrequencyCap 的订阅分类）
# =============================================================================
FREQUENCY_CAP_DEFAULT_MAX=10
FREQUENCY_CAP_DEFAULT_DAYS=7

# =============================================================================
# 隐私 / 合规
# =============================================================================
# 是否存储点击 IP 地址（默认 true；false 时仅存哈希）
STORE_IP_ADDRESSES=true

# =============================================================================
# 监控与日志
# =============================================================================
SENTRY_DSN=
LOG_LEVEL=info
NODE_ENV=development

# =============================================================================
# Worker
# =============================================================================
# Worker 轮询间隔（毫秒；默认 60000）
WORKER_POLL_INTERVAL=60000

# =============================================================================
# 自定义事件 API 鉴权（本期新增；与 ADMIN_TOKEN 必须分离）
# 用于 POST /api/events/custom，请求头 X-Event-Token 必须严格匹配
# 生产建议使用 32 字节以上随机串：`openssl rand -hex 32`
# =============================================================================
EVENT_API_TOKEN=

# =============================================================================
# 限流（本期新增；进程内 Map + 时间窗口；多实例不在本期范围）
# =============================================================================
# 登录限流：每 IP / 每 admin 在 WINDOW 秒内最多 MAX 次失败尝试
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900
# 测试发送限流：每个登录 admin 在 WINDOW 秒内最多 MAX 次测试发送
RATE_LIMIT_TEST_SEND_MAX=60
RATE_LIMIT_TEST_SEND_WINDOW_SEC=3600
# 自定义事件 API 限流：每个 userId 或 email 在 WINDOW 秒内最多 MAX 次
RATE_LIMIT_EVENT_MAX=600
RATE_LIMIT_EVENT_WINDOW_SEC=3600

# =============================================================================
# SMTP 发件通道（spec: docs/superpowers/specs/modules/smtp-configuration.md）
# 凭证使用 AES-256-GCM 加密落库，密钥经 HKDF 派生自 SESSION_SECRET。
# =============================================================================
# 单个 SmtpConfig 连续失败达到此阈值时写 DeliverabilityAlert（V1 不自动降级）
SMTP_FAILURE_THRESHOLD=20
# nodemailer.verify() 与连接测试的总超时（毫秒）
SMTP_TEST_TIMEOUT_MS=30000
